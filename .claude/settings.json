{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-gh-title.mjs",
            "timeout": 15,
            "statusMessage": "check-gh-title (titres gh accentués, #43)"
          },
          {
            "type": "command",
            "command": "node scripts/check-git-restore.mjs",
            "timeout": 15,
            "statusMessage": "check-git-restore (checkout/restore/stash sur arbre sale)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/verify.sh",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "verify.sh (tsc + lint:tokens + lint:accents + cargo fmt + cargo check)"
          }
        ]
      }
    ]
  }
}
